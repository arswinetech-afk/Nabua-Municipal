# Optional overrides. The defaults in src/lib/supabase.ts point at the
# municipal Supabase project; set these to point a build somewhere else.
VITE_SUPABASE_URL=https://ngdyerhiwomreblxqmis.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_OcGFk8x0h13s9aggSife7w_AgEN5Rkx
# Set to "false" for a standalone (registry-only) deployment with no server.
VITE_SUPABASE_ENABLED=true

# --- Demonstration material (see docs/GO_LIVE.md §2) -------------------
# Production builds (vite build) hide the demonstration accounts on the
# sign-in page and start every device with an EMPTY on-device registry.
# Development and test builds always keep both. Set these to "true" ONLY to
# produce a deliberate training bundle:
#VITE_SHOW_DEMO_ACCOUNTS=true
#VITE_DEMO_SEED=true
